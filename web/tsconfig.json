{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e-3002/types/**/*.ts",
    ".next-e2e-3002/dev/types/**/*.ts",
    ".next-e2e-3003/types/**/*.ts",
    ".next-e2e-3003/dev/types/**/*.ts",
    ".next-e2e-3004/types/**/*.ts",
    ".next-e2e-3004/dev/types/**/*.ts",
    ".next-manual-check/types/**/*.ts",
    ".next-manual-check/dev/types/**/*.ts",
    ".next-e2e-13100/types/**/*.ts",
    ".next-e2e-13100/dev/types/**/*.ts",
    ".next-e2e-13200/types/**/*.ts",
    ".next-e2e-13200/dev/types/**/*.ts",
    ".next-e2e-13001/types/**/*.ts",
    ".next-e2e-13001/dev/types/**/*.ts",
    ".next-manual-3001/types/**/*.ts",
    ".next-manual-3001/dev/types/**/*.ts",
    ".next-e2e-13002/types/**/*.ts",
    ".next-e2e-13002/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "web"
  ]
}
