APP_ENV=production
APP_NAME=auditable-agent-runtime
SECRET_KEY=replace-with-a-random-64-character-secret
ACCESS_TOKEN_TTL_MINUTES=30
MIGRATION_DATABASE_URL=postgresql+psycopg://agent:${POSTGRES_PASSWORD}@postgres:5432/agent_runtime
APP_DATABASE_URL=postgresql+psycopg://agent_runtime:${APP_DATABASE_PASSWORD}@postgres:5432/agent_runtime
DB_ECHO=false
REDIS_URL=redis://redis:6379/0
ALLOWED_ORIGINS=https://agent.example.com
MODEL_PROVIDER=openai_compatible
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=replace-with-secret-manager-injected-key
MODEL_NAME=gpt-4o-mini
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
MODEL_CIRCUIT_THRESHOLD=3
MODEL_COST_PER_1K_INPUT_USD=0.00027
MODEL_COST_PER_1K_OUTPUT_USD=0.0011
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MAX_UPLOAD_BYTES=2000000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PASSWORD_PATH=runtime/smtp_password
SMTP_FROM=no-reply@agent.example.com
SMTP_USE_TLS=true
PUBLIC_APP_URL=https://agent.example.com
POSTGRES_PASSWORD=replace-with-secret-manager-injected-password
APP_DATABASE_PASSWORD=replace-with-a-distinct-runtime-password
