APP_ENV=development
APP_NAME=auditable-agent-runtime
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=30
DATABASE_URL=postgresql+psycopg://agent:agent@postgres:5432/agent_runtime
MIGRATION_DATABASE_URL=postgresql+psycopg://agent:agent@postgres:5432/agent_runtime
APP_DATABASE_URL=postgresql+psycopg://agent_runtime:agent_runtime@postgres:5432/agent_runtime
DB_ECHO=false
REDIS_URL=redis://redis:6379/0
ALLOWED_ORIGINS=http://localhost:3000
MODEL_PROVIDER=mock
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
MODEL_CIRCUIT_THRESHOLD=3
MODEL_COST_PER_1K_INPUT_USD=0.00027
MODEL_COST_PER_1K_OUTPUT_USD=0.0011
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MAX_UPLOAD_BYTES=2000000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
PUBLIC_APP_URL=http://localhost:3000
WORKER_ID=worker-1
# Optional authenticated browser tests (keep credentials in CI secrets or local env only)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_TENANT_SLUG=demo
